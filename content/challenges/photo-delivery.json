{
  "schema_version": 1,
  "challenge_id": "photo-delivery",
  "version": "0.1.0",
  "title": "Photo delivery",
  "level": 4,
  "brief": "Upload immutable photos and serve repeated reads through byte-limited links.",
  "concepts": [
    "object storage",
    "CDN",
    "network bytes"
  ],
  "allowed_component_types": [
    "client",
    "load_balancer",
    "api_gateway",
    "app_service",
    "sql_database",
    "cache",
    "message_queue",
    "worker",
    "object_storage",
    "cdn"
  ],
  "operations": [
    {
      "id": "get_photo",
      "kind": "get_object",
      "weight": 0.95,
      "request_bytes": 512,
      "response_bytes": 1048576,
      "deadline_ms": 10000,
      "retry_safe": true
    },
    {
      "id": "put_photo",
      "kind": "put_object",
      "weight": 0.05,
      "request_bytes": 1048576,
      "response_bytes": 512,
      "deadline_ms": 10000,
      "retry_safe": false
    }
  ],
  "initial_data": {
    "kind": "immutable_objects",
    "namespace": "photos",
    "record_count": 100,
    "initial_version": 0,
    "object_bytes": 1048576
  },
  "workload": {
    "warmup_seconds": 60,
    "measurement_seconds": 300,
    "drain_seconds": 30,
    "assessment_seeds": [
      101,
      202,
      303,
      404,
      505
    ],
    "key_distribution": {
      "type": "zipf",
      "key_count": 100,
      "exponent": 1.2
    }
  },
  "scenarios": [
    {
      "id": "steady",
      "required": true,
      "warmup_rps": 20,
      "rate_segments": [
        {
          "start_s": 0,
          "end_s": 300,
          "rps": 20
        }
      ],
      "faults": []
    },
    {
      "id": "burst",
      "required": true,
      "warmup_rps": 20,
      "rate_segments": [
        {
          "start_s": 0,
          "end_s": 120,
          "rps": 20
        },
        {
          "start_s": 120,
          "end_s": 180,
          "rps": 80
        },
        {
          "start_s": 180,
          "end_s": 300,
          "rps": 20
        }
      ],
      "faults": []
    },
    {
      "id": "cold_cdn",
      "required": true,
      "warmup_rps": 20,
      "rate_segments": [
        {
          "start_s": 0,
          "end_s": 120,
          "rps": 20
        },
        {
          "start_s": 120,
          "end_s": 180,
          "rps": 80
        },
        {
          "start_s": 180,
          "end_s": 300,
          "rps": 20
        }
      ],
      "faults": [
        {
          "type": "clear_cdn",
          "at_s": 120,
          "target_component_type": "cdn"
        }
      ]
    }
  ],
  "requirements": [
