{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "request",
            "cache_miss",
            "invalidate",
            "consume"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Operation Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "operation_ids"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "client",
            "load_balancer",
            "api_gateway",
            "app_service",
            "sql_database",
            "cache",
            "message_queue",
            "worker",
            "object_storage",
            "cdn"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "instance_count": {
          "maximum": 32,
          "minimum": 1,
          "title": "Instance Count",
          "type": "integer"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "position": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "profile_id",
        "instance_count",
        "settings",
        "position"
      ],
      "title": "Node",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "design_id": {
      "title": "Design Id",
      "type": "string"
    },
    "revision_id": {
      "title": "Revision Id",
      "type": "string"
    },
    "challenge_id": {
      "title": "Challenge Id",
      "type": "string"
    },
    "challenge_version": {
      "const": "0.1.0",
      "title": "Challenge Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Revision Id"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 25,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "maxItems": 60,
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "design_id",
    "revision_id",
    "challenge_id",
    "challenge_version",
    "created_at",
    "parent_revision_id",
    "nodes",
    "edges"
  ],
  "title": "DesignRevision",
  "type": "object"
}
